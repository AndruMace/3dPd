{
  "name": "pixel-dungeon-3d",
  "version": "0.0.1",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "refs": "tsx tools/fetch-refs.ts",
    "sim": "tsx tools/sim/run.ts",
    "assets": "tsx tools/import-assets.ts && tsx tools/extract-sprite-defs.ts && tsx tools/extract-constants.ts",
    "cap:sync": "npm run build && cap sync",
    "ios": "npm run build && cap sync ios && cap open ios",
    "android": "npm run build && cap sync android && cap open android",
    "sim:action": "tsx tools/sim/action.ts"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.9",
    "@capacitor/ios": "^7.6.9",
    "preact": "^11.0.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "@eslint/js": "^9.39.5",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.4",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.186.0",
    "eslint": "^9.39.5",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
